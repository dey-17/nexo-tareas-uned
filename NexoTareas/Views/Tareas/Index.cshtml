<section class="intro" aria-labelledby="titulo">
    <p class="eyebrow">ORGANIZACIÓN PERSONAL</p>
    <h1 id="titulo">Un espacio para tus pendientes.</h1>
    <p class="lead">El punto de partida para organizar el trabajo de cada día.</p>
</section>
<div class="workspace">
    <section id="panel-tareas" class="card" aria-labelledby="titulo-lista" data-consulta-url="@Url.Action("Consultar", "Tareas")">
        @Html.AntiForgeryToken()
        <form id="crear-tarea" class="task-form" action="@Url.Action("Crear", "Tareas")" method="post" novalidate>
            <h2>Nueva tarea</h2>
            <p class="form-help">Ambos campos son obligatorios. La tarea se guardará como pendiente.</p>
            <label for="titulo-tarea">Título</label>
            <input id="titulo-tarea" name="titulo" type="text" maxlength="100" required aria-describedby="ayuda-titulo" />
            <small id="ayuda-titulo">Máximo 100 caracteres.</small>
            <label for="descripcion-tarea">Descripción</label>
            <textarea id="descripcion-tarea" name="descripcion" rows="3" maxlength="1000" required aria-describedby="ayuda-descripcion"></textarea>
            <small id="ayuda-descripcion">Máximo 1000 caracteres.</small>
            <button id="guardar-tarea" class="button" type="submit">Crear tarea</button>
            <p id="error-crear" class="form-error" role="alert" hidden></p>
            <p id="exito-crear" class="form-success" role="status" hidden></p>
        </form>
        <div class="card-heading">
            <div><p class="eyebrow">MI ESPACIO DE TRABAJO</p><h2 id="titulo-lista">Mis tareas</h2></div>
            <button id="actualizar" type="button" class="button">Actualizar lista <span aria-hidden="true">↻</span></button>
        </div>
        <p id="estado-consulta" class="status" role="status" aria-live="polite">Consultando la sesión…</p>
        <div id="error-consulta" class="error" role="alert" hidden></div>
        <div id="lista-vacia" class="empty" hidden>
            <div class="empty-icon" aria-hidden="true">✓</div>
            <h3>Todavía no hay tareas</h3>
            <p>La lista de esta sesión está vacía.<br />Crea tu primer pendiente con el formulario.</p>
        </div>
        <ul id="tareas-creadas" class="task-list" aria-label="Tareas de esta sesión"></ul>
    </section>
    <aside class="side-card" aria-labelledby="titulo-avance">
        <span class="step">AVANCE 02 / 08</span>
        <h2 id="titulo-avance">Empieza con una tarea.</h2>
        <p>Registra un título y una descripción sin salir de esta página.</p>
        <ul><li>Proyecto ASP.NET MVC</li><li>Consulta mediante jQuery y Ajax</li><li>Lista independiente por sesión</li></ul>
        <div class="next"><span>PRÓXIMO PASO</span><strong>Consulta y resumen</strong><p>Mejorar el listado y sus indicadores.</p></div>
    </aside>
</div>
