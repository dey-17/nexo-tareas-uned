<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Teknoba · Mis pendientes</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/site.css?v=filtros")" />
</head>
<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="topbar">
        <a class="brand" href="@Url.Action("Index", "Tareas")"><span class="brand-mark" aria-hidden="true">T</span><span>TEKNOBA <span class="brand-name">TAREAS</span></span></a>
        <span class="version">Prototipo en desarrollo</span>
    </header>
    <main id="contenido">@RenderBody()</main>
    <footer>Las tareas de esta sesión son temporales. Se pierden tras 30 minutos de inactividad o al reiniciar el servidor.</footer>
    <noscript><p class="notice">Se necesita JavaScript para consultar las tareas mediante Ajax.</p></noscript>
    <script src="@Url.Content("~/Scripts/jquery-3.7.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/app.js?v=filtros")"></script>
</body>
</html>
